# ─── TCMB EVDS API ────────────────────────────────────────────────────────────
# Faiz, enflasyon ve döviz kuru verisi için TCMB EVDS anahtarı.
# Yoksa /api/tcmb mock veriye fallback yapar.
# Ücretsiz kayıt: https://evds2.tcmb.gov.tr/index.php?lang=tr
# EVDS_API_KEY=your_key_here

# ─── DEBUG CONSOLE ────────────────────────────────────────────────────────────
# /debug sayfasını production'da açmak için "true" yap.
# Boş bırakılırsa /debug yalnızca NODE_ENV=development ortamında erişilebilir.
# DEBUG_ENABLED=false
