# ─── TCMB EVDS API ────────────────────────────────────────────────────────────
# Döviz kuru, faiz, enflasyon ve rezerv verisi için TCMB EVDS anahtarı.
# Ücretsiz kayıt: https://evds2.tcmb.gov.tr/index.php?lang=tr
# EVDS_API_KEY=your_key_here

# ─── ALPHA VANTAGE API ────────────────────────────────────────────────────────
# USD/TRY ve EUR/TRY için EVDS yedek kaynağı.
# Ücretsiz kayıt (5 istek/dk, 500/gün): https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_key_here

# ─── FRED API (St. Louis Fed) ─────────────────────────────────────────────────
# Şimdilik yalnızca /debug ekranında doğrulama için kullanılıyor.
# Ücretsiz kayıt: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_key_here

# ─── DEBUG CONSOLE ────────────────────────────────────────────────────────────
# /debug sayfasını production'da açmak için "true" yap.
# DEBUG_ENABLED=false
